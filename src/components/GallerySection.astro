---
---
<section id="gallery" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 pb-1">Photo gallery</h2>
      <p class="text-gray-500 text-lg mt-4 leading-relaxed">A visual preview of what awaits. Click any image for full-screen view.</p>
    </div>
    <div class="columns-1 md:columns-2 lg:columns-3 gap-4 space-y-4">
      {([
        { src: "/images/kunming-stone-forest.webp", alt: "Stone Forest limestone karst formations at sunrise, Kunming" },
        { src: "/images/lijiang-old-town.webp", alt: "Lijiang ancient town lantern-lit cobblestone streets at dusk" },
        { src: "/images/dali-erhai.webp", alt: "Erhai Lake with Cangshan Mountains backdrop at sunrise, Dali" },
        { src: "/images/shangri-la-monastery.webp", alt: "Songzanlin Monastery golden roofs against Tibetan Plateau sky" },
        { src: "/images/yuanyang-terraces.webp", alt: "Yuanyang rice terraces reflecting dawn colors, Hani terraces" },
        { src: "/images/xishuangbanna-rainforest.webp", alt: "Misty tropical rainforest canopy in Xishuangbanna" },
        { src: "/images/lijiang-jade-dragon.webp", alt: "Jade Dragon Snow Mountain 5,596m peak with glacier" },
        { src: "/images/dali-pagodas.webp", alt: "Three Pagodas of Dali, 9th-century brick towers against mountain backdrop" },
        { src: "/images/shangri-la-pudacuo.webp", alt: "Shudu Lake mirror-like waters surrounded by fir forest, Pudacuo National Park" },
      ]).map((img) => (<img src={img.src} alt={img.alt} class="w-full rounded-2xl cursor-pointer hover:opacity-90 transition-opacity" loading="lazy" data-gallery-img />))}
    </div>
  </div>
</section>
