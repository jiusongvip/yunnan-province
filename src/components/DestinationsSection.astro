---
import { destinations } from "../data/destinations";
---
<section id="destinations" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 pb-1">Where to go in Yunnan</h2>
      <p class="text-gray-500 text-lg mt-4 leading-relaxed">Six destinations, each a different world. Click through for detailed guides with maps, food, and logistics.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {destinations.map((dest) => (
        <a href={`/${dest.slug}`} class="dest-card group block relative overflow-hidden rounded-2xl bg-gray-100">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={dest.image} alt={`${dest.name}, ${dest.region}`} class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5">
            <div class="text-xs font-semibold text-white/70 uppercase tracking-wider mb-1">{dest.region}</div>
            <h3 class="text-xl font-bold text-white">{dest.name}</h3>
            <p class="text-sm text-white/70 mt-1">{dest.altitude}m above sea level</p>
            <span class="inline-flex items-center gap-1 mt-2 text-sm font-medium text-white opacity-0 group-hover:opacity-100 transition-opacity">View guide <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
