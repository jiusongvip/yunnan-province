---
---
<section id="accommodation" class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 pb-1">Where you will sleep in Yunnan</h2>
      <p class="text-gray-500 text-lg mt-4 leading-relaxed">Not just a bed. Yunnan accommodation is part of the experience. Choose wisely.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { type: "Courtyard Guesthouse", where: "Lijiang, Dali", price: "CNY 150-500", vibe: "Sleep in a 700-year-old wooden building around a stone courtyard. Morning tea in the sun, red lanterns at night.", know: "Rooms can be cold in winter. Bring earplugs for thin wooden walls." },
        { type: "Tibetan Homestay", where: "Shangri-La", price: "CNY 80-200", vibe: "A Tibetan family hosts you. Yak butter tea by the stove. Buddhist prayer flags outside your window.", know: "Basic facilities. Altitude sickness may make the first night rough. The family will look after you." },
        { type: "Terrace View Lodge", where: "Yuanyang", price: "CNY 200-500", vibe: "Wake up to sunrise over mirrors of water cascading down mountains. The reason photographers stay for days.", know: "Remote. Limited dining options. Bring snacks. Book the sunrise-facing room." },
        { type: "Jungle Bungalow", where: "Xishuangbanna", price: "CNY 100-300", vibe: "Bamboo and wood houses among tropical plants. Feels more like northern Thailand than China.", know: "Mosquitoes are intense. Cold showers in some places. Bring repellent." },
      ].map((acc) => (
        <div class="bg-white rounded-2xl p-6 border border-gray-100 hover:border-brand-200 hover:shadow-md transition-all">
          <div class="text-xs font-semibold text-brand-600 uppercase tracking-wider mb-2">{acc.type}</div>
          <div class="flex items-center gap-2 text-xs text-gray-400 mb-4"><span>{acc.where}</span><span class="text-gray-200">|</span><span class="font-medium text-gray-600">{acc.price}</span></div>
          <p class="text-sm text-gray-600 leading-relaxed mb-4">{acc.vibe}</p>
          <div class="text-xs text-amber-700 bg-amber-50 rounded-lg p-3 leading-relaxed">Know before booking: {acc.know}</div>
        </div>
      ))}
    </div>
  </div>
</section>
