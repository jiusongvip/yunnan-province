---
---
<section class="py-12 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-px overflow-hidden rounded-lg border border-gray-200 bg-gray-200 sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-white p-5">
        <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-gray-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Best Season
        </p>
        <p class="mt-1 font-semibold text-gray-900">March-May & Sept-Nov</p>
        <p class="text-xs text-gray-400 mt-0.5">Year-round possible</p>
      </div>
      <div class="bg-white p-5">
        <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-gray-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Recommended Days
        </p>
        <p class="mt-1 font-semibold text-gray-900">8-14 days</p>
        <p class="text-xs text-gray-400 mt-0.5">Minimum 5 for highlights</p>
      </div>
      <div class="bg-white p-5">
        <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-gray-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2z"/></svg>
          Daily Budget
        </p>
        <p class="mt-1 font-semibold text-gray-900">CNY 150-1,500</p>
        <p class="text-xs text-gray-400 mt-0.5">Backpacker to comfort</p>
      </div>
      <div class="bg-white p-5">
        <p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-gray-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
          Altitude Range
        </p>
        <p class="mt-1 font-semibold text-gray-900">500m - 3,400m</p>
        <p class="text-xs text-gray-400 mt-0.5">Ascend gradually</p>
      </div>
    </div>
  </div>
</section>