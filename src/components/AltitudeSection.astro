---
import { destinations } from "../data/destinations";
---
<section id="altitude" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 pb-1">Altitude guide</h2>
      <p class="text-gray-500 text-lg mt-4 leading-relaxed">From 500m to 3,400m. Altitude sickness is real in Shangri-La. Plan a gradual ascent: Kunming > Dali > Lijiang > Shangri-La.</p>
    </div>
    <div class="space-y-6 max-w-2xl">
      {destinations.map((dest, i) => (
        <div class="flex items-center gap-4 group">
          <div class="w-8 text-right text-xs font-semibold text-gray-400">{dest.altitude}m</div>
          <div class={`h-8 rounded-r-lg flex items-center px-4 transition-all duration-700 ${
            i === 0 ? "bg-green-400 w-[35%]" : i === 1 ? "bg-blue-400 w-[48%]" : i === 2 ? "bg-yellow-500 w-[50%]" : i === 3 ? "bg-orange-500 w-[85%]" : i === 4 ? "bg-green-400 w-[35%]" : "bg-green-300 w-[12%]"
          }`}>
            <span class="text-sm font-semibold text-white drop-shadow-sm">
              {dest.name} {dest.altitude >= 3000 ? " (altitude sickness risk)" : dest.altitude >= 2000 ? " (mild altitude)" : " (comfortable)"}
            </span>
          </div>
          <a href={"/" + dest.slug} class="text-xs text-brand-600 font-medium opacity-0 group-hover:opacity-100 transition-opacity hidden md:block">Guide</a>
        </div>
      ))}
      <div class="flex items-center gap-4 mt-2">
        <div class="w-8"></div>
        <div class="flex gap-6 text-xs text-gray-400">
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-400"></span> Safe</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-500"></span> Moderate</span>
          <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-orange-500"></span> Risk zone</span>
        </div>
      </div>
    </div>
  </div>
</section>
