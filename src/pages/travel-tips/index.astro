---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const tips = [
  { title: "Visa", icon: "V", desc: "Most visitors need a tourist (L) visa. Apply at your local Chinese embassy 4-6 weeks before travel. Some nationalities can use the 144-hour transit visa for Kunming. Yunnan has no special visa-free zone — you need a full China visa unless transiting." },
  { title: "VPN", icon: "V", desc: "Google, WhatsApp, Instagram, Facebook, Gmail, and most Western platforms are blocked in China. Install a reliable paid VPN before you leave home. Test it before departure. Free VPNs rarely work. Some hotel Wi-Fi networks block VPN connections — have a backup." },
  { title: "Money", icon: "M", desc: "China is nearly cashless. Set up Alipay or WeChat Pay before arrival (both now support foreign credit cards). Carry CNY 500-1,000 in cash for small vendors and rural areas. ATMs accept international cards at Bank of China and ICBC branches. Notify your bank before traveling." },
  { title: "Language", icon: "L", desc: "English is rare outside major hotels and tourist sites. Download Pleco (Chinese-English dictionary) and Baidu Translate (works offline). Learn key phrases: 'ni hao' (hello), 'xie xie' (thank you), 'duo shao qian' (how much). Show your destination written in Chinese characters." },
  { title: "Connectivity", icon: "C", desc: "Buy a local SIM card at Kunming airport on arrival (China Mobile or China Unicom, ~CNY 100 for 20GB). Or use an eSIM from providers like Airalo or Nomad. Free Wi-Fi is common in hotels and cafes but requires a Chinese phone number to register." },
  { title: "Altitude", icon: "A", desc: "Kunming (1,890m) is generally fine. Lijiang (2,400m) may cause mild headaches. Shangri-La (3,400m) needs 1-2 acclimatization days. Symptoms: headache, nausea, fatigue, poor sleep. Prevention: ascend gradually, hydrate, avoid alcohol on arrival. Diamox (acetazolamide) can help — consult your doctor." },
  { title: "Health", icon: "H", desc: "No required vaccinations for Yunnan. Travel insurance is strongly recommended — medical evacuations are expensive. Tap water is NOT safe to drink. Buy bottled water (widely available). Pharmacies are common in cities; bring prescription medications from home." },
  { title: "Etiquette", icon: "E", desc: "Dress modestly at monasteries and temples (cover shoulders and knees). Ask before photographing people, especially in minority villages. Tipping is NOT expected anywhere in China. Remove shoes when entering Tibetan homes or temple prayer halls." },
  { title: "Transport Apps", icon: "T", desc: "Didi (Chinese Uber) works in all Yunnan cities — link it to Alipay. For trains, use Trip.com or China Railways (12306.cn). Baidu Maps is the best offline map for China (Google Maps data is unreliable in China)." },
  { title: "Safety", icon: "S", desc: "Yunnan is very safe. Violent crime against tourists is extremely rare. The main risks are practical: slippery trails after rain, altitude sickness at high elevations, and stomach issues from street food. Solo female travelers report feeling safe throughout Yunnan. Keep copies of your passport and visa." },
];

const schema = {
  "@type": "Article",
  "headline": "Yunnan Travel Tips: Visas, VPN, Money, Language & Safety",
  "description": "Essential practical tips for visiting Yunnan: visa requirements, VPN setup, mobile payments, language barriers, altitude sickness prevention, and safety advice.",
  "author": { "@type": "Person", "name": "Yunnan Guide Team" },
  "datePublished": "2026-04-01",
  "dateModified": "2026-08-07",
};
---

<BaseLayout
  title="Yunnan Travel Tips: Visas, VPN, Money, Safety & More"
  description="Essential Yunnan travel tips: Chinese visa guide, VPN setup, Alipay for foreigners, altitude sickness prevention and safety advice for your trip."
  ogType="article"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>
  <Nav />
  <main class="min-h-screen">
    <section class="pt-32 pb-16 bg-gradient-to-b from-brand-50 to-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Yunnan Travel Tips</h1>
        <p class="text-lg text-gray-600">Essential practical advice for a smooth trip — visas, internet, money, language, and safety.</p>
      </div>
    </section>
    <section class="pb-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        {tips.map(t => (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="flex items-center gap-3 mb-2">
              <span class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shrink-0">{t.icon}</span>
              <h3 class="font-bold text-gray-900">{t.title}</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
