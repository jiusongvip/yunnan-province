---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { months } from "../../data/months";
import { destinations as allDestinations } from "../../data/destinations";

// The table below names places in its own condensed wording, so links resolve
// through the real slug list rather than a guessed transformation of the label.
const slugByName = new Map(allDestinations.map((d) => [d.name, d.slug]));
const guideUrl = (name: string) => {
  const slug = slugByName.get(name);
  return slug ? "/" + slug + "/" : null;
};

const destinations = [
  { name: "Kunming", alt: "1,890m", best: "Year-round", avoid: "Rainy Jul-Aug (minor)", note: "Spring City lives up to its name. Temperatures rarely drop below 5C or exceed 28C. Rainy season June-August but it passes quickly." },
  { name: "Dali", alt: "2,000m", best: "Mar-May, Sep-Nov", avoid: "Jul-Aug rain", note: "Mild and comfortable. Strong UV at this altitude. Afternoon winds by Erhai Lake. Cherry blossoms peak in March." },
  { name: "Lijiang", alt: "2,400m", best: "Apr-Oct", avoid: "Jun-Sep rain", note: "Cool at altitude. Nights chilly even in summer. Rainy season (June-September) can obscure mountain views. Snow on Jade Dragon Mountain Nov-Mar." },
  { name: "Shangri-La", alt: "3,400m", best: "May-Oct", avoid: "Dec-Feb (freezing)", note: "High-altitude climate. Dramatic temperature swings (warm sun, cold nights). Winter brings snow. UV is intense. Wildflowers peak Jul-Aug." },
  { name: "Yuanyang Rice Terraces", alt: "1,800m", best: "Nov-Mar (water)", avoid: "May-Sep (planted)", note: "Water-filled terrace season Nov-Mar for photography. Winter mornings foggy. Green growing season Apr-Sep has its own beauty." },
  { name: "Xishuangbanna", alt: "500m", best: "Nov-Mar (dry)", avoid: "Apr-Oct hot", note: "Tropical monsoon. Hot and humid March-October. Dry season Nov-Feb is the best time. Water Splashing Festival mid-April." },
  { name: "Tiger Leaping Gorge", alt: "2,500m (trail)", best: "Mar-May, Sep-Nov", avoid: "Jul-Aug (landslide risk)", note: "The High Trail is a 2-day, 22km trek with vertical drops of 3,900m. Spring and autumn bring clear gorge views. July-August rains make the trail slippery and occasionally close the Lower Gorge walkway." },
  { name: "Stone Forest", alt: "1,750m", best: "Mar-Nov", avoid: "Chinese holidays", note: "A year-round day trip from Kunming. 3-4 hours at the site is plenty; mornings are less crowded. November brings the best light for the karst pillars." },
];

const festivals = [
  { name: "Water Splashing Festival", date: "April 13-15", location: "Xishuangbanna", desc: "Dai New Year. Three days of water fights, dragon boats, and lanterns on the Mekong. The biggest ethnic festival in the province." },
  { name: "Torch Festival", date: "Late July / August", location: "Dali, Lijiang, Chuxiong", desc: "Yi, Bai, and Naxi celebration with bonfires, torch parades, and dancing. Dali Old Town has the biggest event." },
  { name: "Third Month Fair", date: "April (lunar calendar)", location: "Dali", desc: "Bai ethnic festival on Erhai Lake shore. Traditional trading fair with horse racing, singing, and dancing." },
];

const schema = {
  "@type": "Article",
  "headline": "Best Time to Visit Yunnan: Month-by-Month Guide 2026",
  "description": "When to visit Yunnan Province: month-by-month guide with weather, crowds, festivals, and the best months for every destination from Kunming to Shangri-La.",
  "author": { "@type": "Person", "name": "Yunnan Guide Team" },
  "datePublished": "2026-04-01",
  "dateModified": "2026-08-07",
};
---

<BaseLayout
  title="Best Time to Visit Yunnan: Month-by-Month Guide 2026"
  description="When to visit Yunnan Province: seasonal breakdown with weather, crowds, festivals, and ideal months for every destination from Kunming to Shangri-La."
  ogType="article"
  ogImage="/images/og-best-time.webp"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>

  <Nav solid />

  <main class="min-h-screen">
    <section class="pt-32 pb-16 bg-gradient-to-b from-brand-50 to-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Best Time to Visit Yunnan</h1>
        <p class="text-lg text-gray-600">A month-by-month guide to weather, crowds, and the best places to go in each season.</p>
      </div>
    </section>

    <!-- Quick Summary -->
    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg">
        <h2>Quick Summary</h2>
        <p><strong>Best overall:</strong> March-May and September-November. Spring blossoms and comfortable temperatures; autumn brings clear skies and golden landscapes.</p>
        <p><strong>Best for photography:</strong> November-March at Yuanyang rice terraces (water-filled, mirror reflections). October-November in Shangri-La (autumn colors against snow peaks).</p>
        <p><strong>Best for budget:</strong> December-February (except Chinese New Year). Low season prices, fewer tourists. Xishuangbanna is glorious in winter.</p>
        <p><strong>Avoid if possible:</strong> Chinese New Year (late Jan/early Feb), Labor Day (May 1-5), National Day (Oct 1-7). These holidays bring massive domestic tourism crowds and price spikes of 30-50%.</p>

        <h2>Yunnan by Season</h2>

        <h3>Spring (March-May)</h3>
        <p>The most popular season -- and for good reason. Kunming's flowers bloom, Dali's cherry blossoms peak in March, and Lijiang's old town is framed by green willows. Temperatures ideal for outdoor exploration (13-26C). May brings the first rains to the northwest and the Water Splashing Festival to Xishuangbanna.</p>
        <p><strong>Best destinations:</strong> Dali, Lijiang, Kunming, Yuanyang (water-filled terraces through March).</p>

        <h3>Summer (June-August)</h3>
        <p>Rainy season in most of the province. The northwest (Lijiang, Shangri-La) sees afternoon showers daily. Trails can be muddy. However, this is the greenest, most lush time. Wild mushroom season (June-August) is a food lover's pilgrimage. Shangri-La wildflowers peak in July-August.</p>
        <p><strong>Best destinations:</strong> Kunming (mild year-round), Dali (rain is lighter), Shangri-La (wildflowers).</p>

        <h3>Autumn (September-November)</h3>
        <p>The golden season. September sees rains taper off. October and November bring crystal-clear skies, comfortable temperatures, and spectacular autumn colors in high-altitude areas. The only downside: National Day (Oct 1-7) brings enormous crowds.</p>
        <p><strong>Best destinations:</strong> Shangri-La (autumn colors), Lijiang, Dali, Yuanyang (terraces start filling in November).</p>

        <h3>Winter (December-February)</h3>
        <p>Cold in the north, perfect in the south. Shangri-La drops below freezing. Lijiang and Dali are chilly but beautiful with snow-capped mountain backdrops. Xishuangbanna is at its absolute best: warm, dry, and green. Yuanyang's terraces are full of water, creating mirror-like reflections at sunrise.</p>
        <p><strong>Best destinations:</strong> Xishuangbanna, Yuanyang, Kunming.</p>
      </div>
    </section>

    <!-- Month Table -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Month-by-Month Breakdown</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b-2 border-gray-200">
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Month</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Avg Temp</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Rain</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Rating</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Best For</th>
                <th class="text-left py-3 px-4 font-semibold text-gray-900">Verdict</th>
              </tr>
            </thead>
            <tbody>
              {months.map(m => (
                <tr class="border-b border-gray-100 hover:bg-brand-50/50">
                  <td class="py-3 px-4 font-medium text-gray-900"><a href={"/best-time-to-visit/" + m.name.toLowerCase() + "/"} class="hover:text-brand-700 hover:underline">{m.name}</a></td>
                  <td class="py-3 px-4 text-gray-600">{m.temp}</td>
                  <td class="py-3 px-4 text-gray-600">{m.rain}</td>
                  <td class="py-3 px-4"><span class={"px-2 py-0.5 rounded-full text-xs font-medium " + (m.rating === "Excellent" ? "bg-green-100 text-green-700" : m.rating === "Very Good" ? "bg-brand-100 text-brand-700" : m.rating === "Good" ? "bg-blue-100 text-blue-700" : "bg-amber-100 text-amber-700")}>{m.rating}</span></td>
                  <td class="py-3 px-4 text-gray-600">{m.bestFor}</td>
                  <td class="py-3 px-4 text-gray-600 leading-relaxed">{m.verdict}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- By Destination -->
    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Best Time by Destination</h2>
        <div class="space-y-6">
          {destinations.map(d => (
            <div class="rounded-xl border border-gray-200 p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h3 class="font-bold text-gray-900 text-lg">
                    {(() => {
                      const url = guideUrl(d.name);
                      return url ? <a href={url} class="hover:text-brand-700 hover:underline">{d.name}</a> : d.name;
                    })()}
                  </h3>
                  <span class="text-xs text-gray-400">{d.alt}</span>
                </div>
                <div class="flex gap-2">
                  <span class="text-xs font-semibold bg-green-100 text-green-700 px-3 py-1 rounded-full">Best: {d.best}</span>
                  <span class="text-xs font-semibold bg-amber-100 text-amber-700 px-3 py-1 rounded-full">Avoid: {d.avoid}</span>
                </div>
              </div>
              <p class="text-sm text-gray-600 leading-relaxed">{d.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Festivals -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-8">Festivals Worth Planning Around</h2>
        <div class="space-y-4">
          {festivals.map(f => (
            <div class="rounded-xl bg-white border border-gray-200 p-6">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold text-gray-900">{f.name}</h3>
                <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full">{f.location}</span>
              </div>
              <p class="text-xs text-gray-400 mb-2">{f.date}</p>
              <p class="text-sm text-gray-600 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>