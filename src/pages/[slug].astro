---
import { destinations } from "../data/destinations";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { articleSchema, touristDestination, breadcrumbList } from "../utils/schema";
import type { BreadcrumbItem } from "../utils/schema";

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const dest = destinations.find((d) => d.slug === slug);

if (!dest) {
  return Astro.redirect("/404");
}

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Home", url: "https://www.yunnan-province.com/" },
  { name: dest.name, url: "https://www.yunnan-province.com/" + dest.slug },
];

const pageTitle = dest.name.length > 15
  ? dest.name + " – Yunnan Travel Guide 2026"
  : dest.name + " Travel Guide 2026: Tips for Your Yunnan Trip";
const pageDesc = "Complete " + dest.name + " travel guide: things to do, where to stay, local food and practical tips for your Yunnan trip.";

const pageSchema = {
  "@graph": [
    articleSchema({
      headline: pageTitle,
      description: pageDesc,
      imageUrl: dest.image,
    }),
    touristDestination({
      name: dest.name + ", Yunnan",
      description: dest.description,
    }),
    breadcrumbList(breadcrumbs),
  ],
};

// Packing checklist items — derived per destination from its altitude, terrain and activities
const packingItems = (() => {
  const items = [
    "Passport & visa",
    "Small amount of CNY cash — trailside shops and rural vendors take cash only",
    "WeChat Pay or Alipay set up on your phone (most places don't accept cards)",
    "Comfortable walking shoes with grip",
    "Sunscreen & sunglasses",
    "Light rain jacket",
    "Power bank — long bus and train rides",
    "Toilet paper & hand sanitizer (rural restrooms are basic)",
  ];
  if (dest.altitude >= 3000) {
    items.push("Oxygen can (CNY 30, sold everywhere)");
    items.push("Warm layers — nights drop below 5°C even in summer");
  } else if (dest.altitude >= 1800) {
    items.push("A light jacket for cool evenings at altitude");
  }
  if (dest.slug === "tiger-leaping-gorge") {
    items.push("Hiking poles — or grab a sturdy stick from Qiaotou for free");
    items.push("At least 2L of water per day");
    items.push("Cash for trailside fruit and walnut stalls");
  }
  if (dest.slug === "xishuangbanna") {
    items.push("Mosquito repellent — essential in the tropics");
    items.push("Quick-dry clothing — it's 30°C+ and humid");
  }
  if (dest.slug === "yuanyang") {
    items.push("Tripod & warm hat — 5 AM shoots at 1,800m are cold");
    items.push("A thermos of hot tea for sunrise viewpoints");
  }
  return items;
})();
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogImage={dest.image}
  ogType="article"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  </slot>

  <Nav />

  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative h-[60dvh] md:h-[70dvh] flex items-end">
      <div class="absolute inset-0 z-0">
        <img src={dest.image} alt={`${dest.name}, Yunnan Province`} class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-black/20"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-12 md:pb-16">
        <nav class="mb-4 flex items-center gap-2 text-sm text-white/60" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
          <span class="text-white/80">{dest.name}</span>
        </nav>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white max-w-3xl leading-tight">
          {dest.name} <span class="text-white/50 text-2xl md:text-3xl font-light">{dest.chinese}</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mt-4 leading-relaxed">{dest.description}</p>
        <div class="flex flex-wrap items-center gap-4 mt-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
            {dest.altitude}m
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {dest.bestTime}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            {dest.climate}
          </span>
        </div>
      </div>
    </section>

    <!-- Quick Overview -->
    <section class="py-12 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 rounded-xl overflow-hidden">
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Region</p><p class="mt-1 font-semibold text-gray-900">{dest.region}</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Altitude</p><p class="mt-1 font-semibold text-gray-900">{dest.altitude}m</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Best Time</p><p class="mt-1 font-semibold text-gray-900">{dest.bestTime}</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Climate</p><p class="mt-1 font-semibold text-gray-900">{dest.climate}</p></div>
        </div>
      </div>
    </section>

    <!-- Overview -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-6">
          {dest.overview.split("\\n\\n").filter(p => p.trim()).map(p => (
            <p>{p.trim()}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- At a Glance: decision panel -->
    {dest.minDays && (
      <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">At a Glance: Should You Go?</h2>
          <p class="text-gray-500 mb-8">A 30-second read to decide if {dest.name} fits your trip — and how to plan it.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="rounded-xl border border-gray-200 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-2">Minimum Time</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.minDays}</p>
            </div>
            <div class="rounded-xl border border-gray-200 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-2">Physical Demand</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.difficulty}</p>
            </div>
            <div class="rounded-xl border border-gray-200 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-2">Daily Budget</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.budgetLevel}</p>
            </div>
            <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 mb-2">Best For</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.bestFor}</p>
            </div>
            <div class="rounded-xl border border-red-200 bg-red-50/50 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-red-700 mb-2">Not For</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.notFor}</p>
            </div>
            <div class="rounded-xl border border-gray-200 p-5">
              <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-2">Best Season</p>
              <p class="text-sm text-gray-800 font-medium leading-relaxed">{dest.bestTime}</p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Day Plans: time-option comparison -->
    {dest.dayPlans && dest.dayPlans.length > 0 && (
      <section class="py-16 bg-gray-50">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Plan Your Time in {dest.name}</h2>
          <p class="text-gray-500 mb-8">Three ways to do it — pick the one that fits your schedule, then follow the steps.</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {dest.dayPlans.map((plan, pi) => (
              <div class="rounded-2xl bg-white border border-gray-200 p-6 flex flex-col">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-bold uppercase tracking-widest text-brand-700 bg-brand-50 px-3 py-1.5 rounded-full">{plan.label}</span>
                  <span class="w-8 h-8 rounded-full bg-gray-900 text-white flex items-center justify-center font-bold text-sm">{pi + 1}</span>
                </div>
                <ol class="space-y-3 flex-1">
                  {plan.steps.map((step, si) => (
                    <li class="flex items-start gap-3 text-sm text-gray-700 leading-relaxed">
                      <span class="w-5 h-5 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">{si + 1}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Budget Calculator -->
    {dest.dailyBudget && (
      <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="rounded-2xl border border-brand-100 bg-brand-50/30 p-8 md:p-10" data-budget-calculator data-tiers={JSON.stringify(dest.dailyBudget)}>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Estimate Your {dest.name} Budget</h2>
            <p class="text-gray-500 mb-8 leading-relaxed">Per-person daily costs we recorded on the ground in 2026 — accommodation, food, local transport, and one paid sight per day. Drag to plan; everything runs in your browser.</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-2">Days in {dest.name}</label>
                <input type="range" min="1" max="14" value="2" class="w-full accent-brand-600" data-bc-days />
                <p class="mt-1 text-sm text-gray-500">Minimum recommended: {dest.minDays}</p>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-800 mb-2">Travelers</label>
                <input type="range" min="1" max="6" value="2" class="w-full accent-brand-600" data-bc-people />
                <p class="mt-1 text-sm text-gray-500">Everyone sharing the trip</p>
              </div>
              <div>
                <p class="block text-sm font-semibold text-gray-800 mb-2">Travel Style</p>
                <div class="flex gap-2" data-bc-tiers>
                  <button type="button" data-tier="budget" class="flex-1 px-3 py-2 rounded-lg border border-gray-200 text-gray-700 text-sm font-semibold transition-colors">Budget</button>
                  <button type="button" data-tier="mid" class="flex-1 px-3 py-2 rounded-lg border border-brand-600 bg-brand-600 text-white text-sm font-semibold transition-colors">Mid-range</button>
                  <button type="button" data-tier="comfort" class="flex-1 px-3 py-2 rounded-lg border border-gray-200 text-gray-700 text-sm font-semibold transition-colors">Comfort</button>
                </div>
                <p class="mt-1 text-sm text-gray-500">Budget = dorms & street food · Mid = guesthouses & local restaurants · Comfort = boutique hotels & nice dinners</p>
              </div>
            </div>
            <div class="mt-8 pt-8 border-t border-brand-100 flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-1">Estimated trip total (accommodation + food + transport + one sight per day)</p>
                <p class="text-3xl md:text-4xl font-bold text-gray-900" data-bc-result>—</p>
              </div>
              <p class="text-sm text-gray-500 max-w-sm leading-relaxed" data-bc-note></p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Field Experience Note -->
    {dest.experienceNote && (
      <section class="py-12 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="relative rounded-2xl border border-brand-100 bg-brand-50/40 p-8 md:p-10">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 rounded-l-2xl bg-brand-500"></div>
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-600 mb-4">From our travels in {dest.name}</p>
            <blockquote class="text-gray-700 text-lg md:text-xl leading-relaxed font-serif italic">
              "{dest.experienceNote}"
            </blockquote>
          </div>
        </div>
      </section>
    )}

    <!-- Highlights -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Top Attractions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {dest.highlights.map((h, i) => (
            <div class="flex items-center gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100">
              <div class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">{i + 1}</div>
              <span class="text-gray-900 font-medium text-sm">{h}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Activities -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Things to Do</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {dest.activities.map((a) => (
            <div class="flex items-center gap-3 p-4 rounded-xl bg-white border border-gray-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2.5" stroke-linecap="round" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="text-gray-700 text-sm">{a}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Insider Tips -->
    {dest.tips && dest.tips.length > 0 && (
      <section class="py-16 bg-amber-50">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Insider Tips for {dest.name}</h2>
          <p class="text-gray-500 mb-8">Things we wish someone had told us before visiting {dest.name}.</p>
          <div class="space-y-3">
            {dest.tips.map((tip, i) => (
              <div class="flex items-start gap-3 p-4 rounded-xl bg-white border border-amber-200">
                <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">{i + 1}</div>
                <p class="text-gray-700 text-sm leading-relaxed">{tip}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Local Warnings: What to Skip -->
    {dest.localWarnings && dest.localWarnings.length > 0 && (
      <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">What to Skip & Watch Out For</h2>
          <p class="text-gray-500 mb-8">The honest side of {dest.name} — the crowds, the tourist traps, and the mistakes we see first-timers make.</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {dest.localWarnings.map((w) => (
              <div class="rounded-xl border border-red-100 bg-red-50/60 p-5">
                <h3 class="font-bold text-gray-900 text-sm mb-2 flex items-start gap-2">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" class="shrink-0 mt-0.5"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                  {w.title}
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed">{w.detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Transport -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">How to Get to {dest.name}</h2>
        <p class="text-gray-500 mb-8 leading-relaxed">{dest.transport.fromKunming}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {dest.transport.byTrain && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-green-50 text-green-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Train</h3>
              <p class="text-sm text-gray-500">{dest.transport.byTrain}</p>
            </div>
          )}
          {dest.transport.byBus && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Bus</h3>
              <p class="text-sm text-gray-500">{dest.transport.byBus}</p>
            </div>
          )}
          {dest.transport.byFlight && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.6-.3-1.3.1-1.5.7l-.3 1.1c-.2.6.1 1.3.7 1.5L9 11l-2 4.3-2 .8c-.5.2-.8.7-.6 1.2l.4.8c.2.5.7.7 1.2.5l3.5-1 3.3 4.7c.3.4 1 .5 1.4.2l.8-.5c.4-.3.5-.9.2-1.4L15 15.5l4.2-2.3c.5-.3.7-.9.4-1.4l-.4-.7c-.3-.5-.9-.7-1.4-.4z"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Flight</h3>
              <p class="text-sm text-gray-500">{dest.transport.byFlight}</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Named Picks: Restaurants & Hotels -->
    {(dest.namedRestaurants && dest.namedRestaurants.length > 0) || (dest.namedHotels && dest.namedHotels.length > 0) ? (
      <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">Places We Recommend by Name</h2>
          <p class="text-gray-500 mb-8 leading-relaxed">Real names, real prices — cross-checked with local listings and our own stays in 2026. These are the places we'd send a friend.</p>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {dest.namedRestaurants && dest.namedRestaurants.length > 0 && (
              <div>
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                  <span class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg>
                  </span>
                  Where to Eat & Drink
                </h3>
                <div class="space-y-4">
                  {dest.namedRestaurants.map((r) => (
                    <div class="rounded-xl bg-white border border-gray-200 p-5">
                      <div class="flex items-start justify-between gap-3">
                        <h4 class="font-bold text-gray-900 text-sm leading-snug">{r.name}</h4>
                        <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full shrink-0">{r.price}</span>
                      </div>
                      <p class="text-sm text-gray-500 mt-2 leading-relaxed">{r.why}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
            {dest.namedHotels && dest.namedHotels.length > 0 && (
              <div>
                <h3 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                  <span class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h20v2H2z"/><path d="M4 6v14h16V6"/><path d="M9 10h6v4H9z"/><path d="M4 16h16"/></svg>
                  </span>
                  Where to Stay
                </h3>
                <div class="space-y-4">
                  {dest.namedHotels.map((h) => (
                    <div class="rounded-xl bg-white border border-gray-200 p-5">
                      <div class="flex items-start justify-between gap-3">
                        <h4 class="font-bold text-gray-900 text-sm leading-snug">{h.name}</h4>
                        <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-full shrink-0">{h.price}</span>
                      </div>
                      <p class="text-sm text-gray-500 mt-2 leading-relaxed">{h.why}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    ) : null}

    <!-- Accommodation -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Where to Stay</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {dest.accommodation.map((a) => (
            <div class="rounded-xl bg-white border border-gray-200 p-6 hover:border-brand-200 transition-colors">
              <h3 class="font-bold text-gray-900 mb-1">{a.type}</h3>
              <p class="text-sm text-gray-500 mb-3">{a.description}</p>
              <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full">{a.priceRange}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Food -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">What to Eat in {dest.name}</h2>
        <div class="space-y-4">
          {dest.food.map((f) => (
            <div class="rounded-xl border border-gray-200 p-5 hover:border-brand-200 transition-colors">
              <h3 class="font-bold text-gray-900">{f.name}</h3>
              <p class="text-sm text-gray-500 mt-1 leading-relaxed">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Packing Checklist -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Packing Checklist for {dest.name}</h2>
        <p class="text-gray-500 mb-8">Tap to check off — your progress saves in this browser, so you can pick up where you left off before the trip.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {packingItems.map((item, i) => (
            <label class="flex items-start gap-3 p-4 rounded-xl bg-white border border-gray-200 cursor-pointer hover:border-brand-200 transition-colors" data-packing-item>
              <input type="checkbox" value={i} class="mt-0.5 w-4 h-4 accent-brand-600" />
              <span class="text-sm text-gray-700 leading-relaxed">{item}</span>
            </label>
          ))}
        </div>
        <div class="mt-6 flex items-center justify-between">
          <p class="text-sm text-gray-500"><span data-packing-count>0</span> of {packingItems.length} packed</p>
          <button type="button" data-packing-reset class="text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors">Reset checklist</button>
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Photo Gallery</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {dest.gallery.map((img, i) => (
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 cursor-pointer" data-gallery-img>
              <img src={img} alt={dest.galleryAlt[i]} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- When to Visit & Itineraries -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="rounded-xl bg-white border border-gray-200 p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">When to Visit {dest.name}</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-2"><strong>Best season:</strong> {dest.bestTime}</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{dest.climate}</p>
            <a href="/best-time-to-visit/" class="text-sm font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
              Full month-by-month guide
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
          <div class="rounded-xl bg-white border border-gray-200 p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Suggested Itineraries</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{dest.name} is included in several of our recommended Yunnan itineraries, from quick 3-day escapes to the full 14-day grand loop.</p>
            <a href="/itineraries/" class="text-sm font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
              View all itineraries
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <div class="mt-4 space-y-2">
              <a href="/compare/" class="flex items-center justify-between text-sm p-3 rounded-lg bg-gray-50 hover:bg-brand-50 transition-colors">
                <span class="text-gray-700">Compare {dest.name} with other destinations</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-brand-950 text-center">
      <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Ready to explore {dest.name}?</h2>
        <p class="text-white/70 mb-8 leading-relaxed">See our recommended itineraries that include {dest.name} or browse other destinations in Yunnan.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/itineraries/" class="px-6 py-3 bg-white text-gray-900 rounded-full font-semibold text-sm hover:bg-brand-50 transition-colors">View Itineraries</a>
          <a href="/#destinations" class="px-6 py-3 bg-brand-600 text-white rounded-full font-semibold text-sm hover:bg-brand-500 transition-colors">All Destinations</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  // Budget calculator: days x travelers x daily tier, with a ±10% range
  document.querySelectorAll("[data-budget-calculator]").forEach((el) => {
    const tiers = JSON.parse(el.dataset.tiers || "{}");
    const daysEl = el.querySelector("[data-bc-days]");
    const peopleEl = el.querySelector("[data-bc-people]");
    const resultEl = el.querySelector("[data-bc-result]");
    const noteEl = el.querySelector("[data-bc-note]");
    const tierButtons = el.querySelectorAll("[data-tier]");
    let tier = "mid";
    const fmt = (n) => "CNY " + Math.round(n).toLocaleString("en-US");
    const update = () => {
      const days = Number(daysEl.value);
      const people = Number(peopleEl.value);
      const per = tiers[tier] || 500;
      const total = per * days * people;
      resultEl.textContent = fmt(total * 0.9) + " – " + fmt(total * 1.1);
      noteEl.textContent =
        days * people + " person-days at " + fmt(per) + " per person/day, plus flights and transfers between destinations.";
    };
    daysEl.addEventListener("input", update);
    peopleEl.addEventListener("input", update);
    tierButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tier = btn.dataset.tier;
        tierButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("bg-brand-600", active);
          b.classList.toggle("border-brand-600", active);
          b.classList.toggle("text-white", active);
        });
        update();
      });
    });
    update();
  });

  // Packing checklist with localStorage persistence per page
  const packingItems = document.querySelectorAll("[data-packing-item]");
  if (packingItems.length) {
    const key = "packing-" + location.pathname;
    const saved = new Set(JSON.parse(localStorage.getItem(key) || "[]"));
    const countEl = document.querySelector("[data-packing-count]");
    const updateCount = () => {
      const checked = [...packingItems].filter((l) => l.querySelector("input").checked);
      if (countEl) countEl.textContent = String(checked.length);
      localStorage.setItem(key, JSON.stringify(checked.map((l) => l.querySelector("input").value)));
    };
    packingItems.forEach((label) => {
      const box = label.querySelector("input");
      const text = label.querySelector("span");
      box.checked = saved.has(box.value);
      if (box.checked) {
        label.classList.add("opacity-60");
        text.classList.add("line-through");
      }
      box.addEventListener("change", () => {
        label.classList.toggle("opacity-60", box.checked);
        text.classList.toggle("line-through", box.checked);
        updateCount();
      });
    });
    const reset = document.querySelector("[data-packing-reset]");
    if (reset) {
      reset.addEventListener("click", () => {
        localStorage.removeItem(key);
        packingItems.forEach((l) => {
          const box = l.querySelector("input");
          box.checked = false;
          l.classList.remove("opacity-60");
          l.querySelector("span").classList.remove("line-through");
        });
        updateCount();
      });
    }
    updateCount();
  }
</script>
