---
import { destinations } from "../data/destinations";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { articleSchema, touristDestination, breadcrumbList } from "../utils/schema";
import type { BreadcrumbItem } from "../utils/schema";

export function getStaticPaths() {
  return destinations.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const dest = destinations.find((d) => d.slug === slug);

if (!dest) {
  return Astro.redirect("/404");
}

const breadcrumbs: BreadcrumbItem[] = [
  { name: "Home", url: "https://yunnan-province.com/" },
  { name: dest.name, url: "https://yunnan-province.com/" + dest.slug },
];

const pageTitle = dest.name.length > 15
  ? dest.name + " – Yunnan Travel Guide 2026"
  : dest.name + " Travel Guide 2026: Tips for Your Yunnan Trip";
const pageDesc = "Complete " + dest.name + " travel guide: things to do, where to stay, local food and practical tips for your Yunnan trip.";

const pageSchema = {
  "@graph": [
    articleSchema({
      headline: pageTitle,
      description: pageDesc,
      imageUrl: dest.image,
    }),
    touristDestination({
      name: dest.name + ", Yunnan",
      description: dest.description,
    }),
    breadcrumbList(breadcrumbs),
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  ogImage={dest.image}
  ogType="article"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  </slot>

  <Nav />

  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative h-[60dvh] md:h-[70dvh] flex items-end">
      <div class="absolute inset-0 z-0">
        <img src={dest.image} alt={`${dest.name}, Yunnan Province`} class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/30 to-black/20"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-12 md:pb-16">
        <nav class="mb-4 flex items-center gap-2 text-sm text-white/60" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5"/></svg>
          <span class="text-white/80">{dest.name}</span>
        </nav>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white max-w-3xl leading-tight">
          {dest.name} <span class="text-white/50 text-2xl md:text-3xl font-light">{dest.chinese}</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 max-w-2xl mt-4 leading-relaxed">{dest.description}</p>
        <div class="flex flex-wrap items-center gap-4 mt-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
            {dest.altitude}m
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {dest.bestTime}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-white text-sm font-medium">
            {dest.climate}
          </span>
        </div>
      </div>
    </section>

    <!-- Quick Overview -->
    <section class="py-12 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 rounded-xl overflow-hidden">
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Region</p><p class="mt-1 font-semibold text-gray-900">{dest.region}</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Altitude</p><p class="mt-1 font-semibold text-gray-900">{dest.altitude}m</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Best Time</p><p class="mt-1 font-semibold text-gray-900">{dest.bestTime}</p></div>
          <div class="bg-white p-5"><p class="text-xs font-medium uppercase tracking-widest text-gray-400">Climate</p><p class="mt-1 font-semibold text-gray-900">{dest.climate}</p></div>
        </div>
      </div>
    </section>

    <!-- Overview -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed space-y-6">
          {dest.overview.split("\\n\\n").filter(p => p.trim()).map(p => (
            <p>{p.trim()}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Top Attractions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {dest.highlights.map((h, i) => (
            <div class="flex items-center gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100">
              <div class="w-8 h-8 rounded-lg bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm shrink-0">{i + 1}</div>
              <span class="text-gray-900 font-medium text-sm">{h}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Activities -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Things to Do</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {dest.activities.map((a) => (
            <div class="flex items-center gap-3 p-4 rounded-xl bg-white border border-gray-100">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2.5" stroke-linecap="round" class="shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
              <span class="text-gray-700 text-sm">{a}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Insider Tips -->
    {dest.tips && dest.tips.length > 0 && (
      <section class="py-16 bg-amber-50">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Insider Tips for {dest.name}</h2>
          <p class="text-gray-500 mb-8">Things we wish someone had told us before visiting {dest.name}.</p>
          <div class="space-y-3">
            {dest.tips.map((tip, i) => (
              <div class="flex items-start gap-3 p-4 rounded-xl bg-white border border-amber-200">
                <div class="w-7 h-7 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">{i + 1}</div>
                <p class="text-gray-700 text-sm leading-relaxed">{tip}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Transport -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">How to Get to {dest.name}</h2>
        <p class="text-gray-500 mb-8 leading-relaxed">{dest.transport.fromKunming}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {dest.transport.byTrain && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-green-50 text-green-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Train</h3>
              <p class="text-sm text-gray-500">{dest.transport.byTrain}</p>
            </div>
          )}
          {dest.transport.byBus && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Bus</h3>
              <p class="text-sm text-gray-500">{dest.transport.byBus}</p>
            </div>
          )}
          {dest.transport.byFlight && (
            <div class="rounded-xl border border-gray-200 p-6">
              <div class="w-10 h-10 rounded-lg bg-sky-50 text-sky-600 flex items-center justify-center mb-3">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.6-.3-1.3.1-1.5.7l-.3 1.1c-.2.6.1 1.3.7 1.5L9 11l-2 4.3-2 .8c-.5.2-.8.7-.6 1.2l.4.8c.2.5.7.7 1.2.5l3.5-1 3.3 4.7c.3.4 1 .5 1.4.2l.8-.5c.4-.3.5-.9.2-1.4L15 15.5l4.2-2.3c.5-.3.7-.9.4-1.4l-.4-.7c-.3-.5-.9-.7-1.4-.4z"/></svg>
              </div>
              <h3 class="font-bold text-gray-900 mb-1">By Flight</h3>
              <p class="text-sm text-gray-500">{dest.transport.byFlight}</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Accommodation -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Where to Stay</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {dest.accommodation.map((a) => (
            <div class="rounded-xl bg-white border border-gray-200 p-6 hover:border-brand-200 transition-colors">
              <h3 class="font-bold text-gray-900 mb-1">{a.type}</h3>
              <p class="text-sm text-gray-500 mb-3">{a.description}</p>
              <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full">{a.priceRange}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Food -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">What to Eat in {dest.name}</h2>
        <div class="space-y-4">
          {dest.food.map((f) => (
            <div class="rounded-xl border border-gray-200 p-5 hover:border-brand-200 transition-colors">
              <h3 class="font-bold text-gray-900">{f.name}</h3>
              <p class="text-sm text-gray-500 mt-1 leading-relaxed">{f.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8">Photo Gallery</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {dest.gallery.map((img, i) => (
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-100 cursor-pointer" data-gallery-img>
              <img src={img} alt={dest.galleryAlt[i]} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- When to Visit & Itineraries -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="rounded-xl bg-white border border-gray-200 p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">When to Visit {dest.name}</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-2"><strong>Best season:</strong> {dest.bestTime}</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{dest.climate}</p>
            <a href="/best-time-to-visit" class="text-sm font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
              Full month-by-month guide
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
          <div class="rounded-xl bg-white border border-gray-200 p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Suggested Itineraries</h2>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{dest.name} is included in several of our recommended Yunnan itineraries, from quick 3-day escapes to the full 14-day grand loop.</p>
            <a href="/itineraries" class="text-sm font-semibold text-brand-600 hover:text-brand-700 inline-flex items-center gap-1">
              View all itineraries
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            <div class="mt-4 space-y-2">
              <a href="/compare" class="flex items-center justify-between text-sm p-3 rounded-lg bg-gray-50 hover:bg-brand-50 transition-colors">
                <span class="text-gray-700">Compare {dest.name} with other destinations</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-brand-950 text-center">
      <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Ready to explore {dest.name}?</h2>
        <p class="text-white/70 mb-8 leading-relaxed">See our recommended itineraries that include {dest.name} or browse other destinations in Yunnan.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/itineraries" class="px-6 py-3 bg-white text-gray-900 rounded-full font-semibold text-sm hover:bg-brand-50 transition-colors">View Itineraries</a>
          <a href="/#destinations" class="px-6 py-3 bg-brand-600 text-white rounded-full font-semibold text-sm hover:bg-brand-500 transition-colors">All Destinations</a>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
