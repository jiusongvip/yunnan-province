---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const itineraries = [
  { days: "3 Days", title: "Kunming & Stone Forest", subtitle: "Perfect for a quick escape or layover", route: "Kunming", highlights: ["Day 1: Green Lake Park, Yuantong Temple, evening food street at Nanping", "Day 2: Stone Forest day trip (2h drive each way)", "Day 3: Western Hills, Dianchi Lake, flower and bird market, depart"], difficulty: "Easy", who: "First-time visitors, layover travelers", dayByDay: [
    { day: "Day 1", title: "Old Kunming at ground level", detail: "Start at 7 AM with tai chi at Green Lake Park while black-headed gulls circle. Walk to Yuantong Temple (1,200 years old, still active), then lose yourself in the hutongs off Zhengyi Road. Evening: Nanping food street — across-the-bridge noodles and erkuai from street stalls.", stay: "Moon & Chalice boutique (old quarter)", eat: "Lao Fang Zi courtyard restaurant, CNY 50/person" },
    { day: "Day 2", title: "The Stone Forest, before the crowds", detail: "Depart Kunming by 6:30 AM (East Bus Station bus, CNY 45-60, 90 min) to beat the tour groups. Spend 3-4 hours in the Greater Stone Forest labyrinth and climb to Wangfeng Pavilion. Return by mid-afternoon train or bus.", stay: "Back in Kunming — Green Lake guesthouses", eat: "Pack snacks; Sani roast chicken at the park road, CNY 80 for two" },
    { day: "Day 3", title: "Dianchi Lake & Western Hills, then fly out", detail: "Morning: cable car or hike up Western Hills to Dragon Gate for the Dianchi panorama. Afternoon: quick pass through the Flower & Bird Market (weekend flea market if it's a Saturday), then to the airport.", stay: "—", eat: "Steam-pot chicken (汽锅鸡) for a final Kunming meal" },
  ] },
  { days: "5 Days", title: "Kunming to Dali to Lijiang", subtitle: "The classic Yunnan introduction", route: "Kunming > Dali > Lijiang", highlights: ["Day 1-2: Kunming highlights + Stone Forest", "Day 3: High-speed train to Dali (2h), explore Ancient City", "Day 4: Morning cycling around Erhai Lake, afternoon Three Pagodas", "Day 5: Train to Lijiang (1.5h from Dali), Lijiang Old Town evening"], difficulty: "Easy", who: "Culture lovers, first-time China visitors", dayByDay: [
    { day: "Days 1-2", title: "Kunming: spring city + stone forest", detail: "Day 1: Green Lake at dawn, Yuantong Temple, old-town hutongs, Nanping food street. Day 2: early Stone Forest trip (leave 6:30 AM), back by afternoon — relax at Green Lake or the Flower & Bird Market.", stay: "Moon & Chalice or Lost Garden (Green Lake)", eat: "Waipo Weidao (Grandma's Kitchen), CNY 40/person" },
    { day: "Day 3", title: "High-speed train to Dali", detail: "CNY 128-230, 2 hours. Check into a courtyard guesthouse, then spend the afternoon on Dali's old-town walls and in the artist-run cafés off Renmin Road. Sunset over Cangshan from the old-town south gate.", stay: "Erhai lakeside guesthouse (Caicun)", eat: "Longxingyuan Restaurant, CNY 150-350/person" },
    { day: "Day 4", title: "Erhai cycling & the Three Pagodas", detail: "Rent an e-bike (CNY 50-80) and ride the western shore to Xizhou: tie-dye workshop, Xizhou baba flatbreads, Yan Family Compound. Return for a late-afternoon visit to the Three Pagodas (CNY 121, allow 3h).", stay: "Same lakeside guesthouse", eat: "Green Field Kitchen café beside Erhai Lake" },
    { day: "Day 5", title: "Train to Lijiang & lantern-lit old town", detail: "1.5h train (CNY 70). Drop bags, then hit the Old Town at golden hour — watch the lanterns come on from the Wangu Tower viewpoint, and eat Naxi grilled fish on a canal-side terrace.", stay: "Naxi courtyard hotel (north of the square)", eat: "Naxi grilled fish & Lijiang baba from street stalls" },
  ] },
  { days: "8 Days", title: "The Classic Northwest", subtitle: "The full Yunnan experience", route: "Kunming > Dali > Lijiang > Shangri-La", highlights: ["Day 1-2: Kunming", "Day 3-4: Dali (Ancient City, Erhai Lake, Xizhou village)", "Day 5-6: Lijiang (Old Town, Jade Dragon Snow Mountain, Black Dragon Pool)", "Day 7-8: Shangri-La (Songzanlin Monastery, Pudacuo, Dukezong Ancient Town)"], difficulty: "Moderate", who: "Travelers wanting the complete picture", dayByDay: [
    { day: "Days 1-2", title: "Kunming: spring city + stone forest", detail: "Follow the 5-day route's Kunming plan: Green Lake at dawn, old-town hutongs, Stone Forest day trip on Day 2, and a Flower & Bird Market stroll before the evening train north.", stay: "Moon & Chalice (old quarter)", eat: "Across-the-bridge noodles at any local favorite" },
    { day: "Day 3", title: "Dali: ancient city & lake", detail: "Morning train (2h). Afternoon: old town, Three Pagodas, sunset from the south gate. Evening: three-course Bai tea ceremony in a courtyard teahouse.", stay: "Sky Valley Heritage Boutique Hotel", eat: "Casa Bai private dinner (book ahead), CNY 500/person" },
    { day: "Day 4", title: "Erhai Lake & Xizhou", detail: "Full-day e-bike ride: Caicun → Xizhou (tie-dye, baba) → back along the lake. Late afternoon: Cangshan cable car if energy allows (3,900m cloud trail).", stay: "Sky Valley (second night)", eat: "Green Field Kitchen lunch, CNY 60-100/person" },
    { day: "Day 5", title: "Lijiang: old town at dawn", detail: "Morning train (1.5h). Drop bags, explore the Old Town before 10 AM (empty streets!), then Black Dragon Pool for the Jade Dragon reflection. Evening: Naxi ancient music performance.", stay: "Hylla Vintage Hotel (Baisha) — book a mountain-view room", eat: "Baisha village restaurants — quiet and authentic" },
    { day: "Day 6", title: "Jade Dragon Snow Mountain", detail: "Full day: cable car to 4,506m, glacier walk, and the Blue Moon Valley below. Book the cable car ticket a day ahead in peak season. Rest early — altitude at 4,500m is no joke.", stay: "Hylla (second night)", eat: "Hotpot in Baisha after the cold mountain air" },
    { day: "Day 7", title: "High road to Shangri-La", detail: "Scenic 4h bus or 1h 15min train to Shangri-La (3,400m). Take it slow — first 24 hours are for acclimatizing. Afternoon: Dukezong Ancient Town and the world's largest prayer wheel.", stay: "Arro Khampa boutique hotel (old town)", eat: "Flying Tiger yak burger, CNY 60-100/person" },
    { day: "Day 8", title: "Songzanlin Monastery & Pudacuo", detail: "Morning: Songzanlin 'Little Potala Palace' at golden hour (CNY 90, no photos inside). Afternoon: Pudacuo National Park boardwalk around Shudu Lake. Evening: fly or train back to Kunming.", stay: "—", eat: "Yak-butter tea and tsampa for the road" },
  ] },
  { days: "10 Days", title: "Northwest Deep Dive + Tiger Leaping Gorge", subtitle: "Adventure meets culture", route: "Kunming > Dali > Lijiang > Tiger Leaping Gorge > Shangri-La", highlights: ["Days 1-6: Follow the Classic Northwest route through Lijiang", "Day 7: Transfer to Qiaotou, start Tiger Leaping Gorge trek", "Day 8: Complete the high trail, transfer to Shangri-La", "Day 9-10: Shangri-La exploration, fly back to Kunming"], difficulty: "Challenging", who: "Fit travelers, hikers, photographers", dayByDay: [
    { day: "Days 1-4", title: "Kunming + Dali", detail: "Same as the 8-day route: Kunming (Stone Forest day trip), then Dali with the Erhai cycling day and a slower pace to save legs for the gorge.", stay: "As the 8-day route", eat: "As the 8-day route" },
    { day: "Day 5", title: "Lijiang & Baisha", detail: "Arrive by train. Old Town at dawn, Black Dragon Pool, then afternoon in Baisha — silk embroidery workshops and the quietest cobbled lanes in the area. Rest early.", stay: "Hylla Vintage Hotel (Baisha)", eat: "Baisha village kitchens" },
    { day: "Day 6", title: "Jade Dragon Snow Mountain", detail: "Cable car to 4,506m + Blue Moon Valley. This is your warm-up for the gorge — hydrate, sleep well.", stay: "Hylla (second night)", eat: "Eat light — big day tomorrow" },
    { day: "Day 7", title: "Tiger Leaping Gorge: Day 1 of the trek", detail: "Morning minibus to Qiaotou (CNY 25-35, 2h), pay CNY 45 entrance, leave your main bag at Jane's Guest House, and start the High Trail by 10 AM. Climb the 28 Bends in the afternoon, sleep at Halfway Guest House (dorm CNY 40).", stay: "Halfway Guest House (terrace sunset is mandatory)", eat: "Halfway kitchen noodles + terrace beer" },
    { day: "Day 8", title: "Tiger Leaping Gorge: Day 2, then Shangri-La", detail: "Finish the High Trail to Tina's (3-4h), optional descent to Tiger Leaping Stone (1,700 steps down — and back up). Bus from the gorge to Shangri-La (1.5-2h). Rest: altitude is coming.", stay: "Arro Khampa (old town)", eat: "Huksum Kitchen hotpot, CNY 80-150/person" },
    { day: "Day 9", title: "Songzanlin & Napa Lake", detail: "Monastery at golden hour, then Napa Lake for yaks and black-necked cranes. Afternoon: Pudacuo boardwalk or a Tibetan homestay experience.", stay: "Arro Khampa (second night)", eat: "Karma Café & yak momos" },
    { day: "Day 10", title: "Fly out from Shangri-La", detail: "Direct flights to Kunming (1h, CNY 600-1,200) or onward. If your flight is late, spend the morning at the giant prayer wheel one last time.", stay: "—", eat: "—" },
  ] },
  { days: "14 Days", title: "Grand Yunnan Loop", subtitle: "From snow peaks to tropical jungles", route: "Kunming > Dali > Lijiang > Shangri-La > (fly) > Xishuangbanna > (fly) > Yuanyang", highlights: ["Days 1-8: Classic Northwest route", "Day 9-10: Fly to Jinghong, explore Xishuangbanna (tropical gardens, Dai culture)", "Day 11-12: Fly to Kunming, bus to Yuanyang rice terraces", "Day 13: Sunrise at Duoyishu, Hani village visits", "Day 14: Return to Kunming, depart"], difficulty: "Challenging", who: "Experienced travelers, photographers, those wanting to see it all", dayByDay: [
    { day: "Days 1-8", title: "The full Northwest route", detail: "Exactly the 8-day Classic Northwest: Kunming, Stone Forest, Dali (Erhai cycling), Lijiang (Jade Dragon), and Shangri-La (Songzanlin + Pudacuo). Add the Tiger Leaping Gorge trek instead of one Lijiang day if you're up for it.", stay: "As the 8-day route", eat: "As the 8-day route" },
    { day: "Day 9", title: "Fly to tropical Jinghong", detail: "Direct flight from Shangri-La or Kunming (1h). Afternoon: Xishuangbanna Tropical Botanical Garden (13,000 species). Evening: the Mekong night market — grilled fish, pineapple rice, papaya salad.", stay: "Gaozhuang boutique hotel", eat: "Mekong night market, CNY 40-80/person" },
    { day: "Day 10", title: "Wild elephants & Dai villages", detail: "Morning: Wild Elephant Valley elevated walkways (observe, never ride). Afternoon: Dai stilt-house village homestay experience — sticky rice grills and temple bells.", stay: "Gaozhuang or a Dai village bungalow", eat: "Dai grilled fish wrapped in banana leaves" },
    { day: "Day 11", title: "Fly back, bus to Yuanyang", detail: "Fly Jinghong → Kunming (1h), then the 6-7h bus to Xinjie Town (CNY 140). Check in with a terrace view — tomorrow you wake before the sun.", stay: "Jackie's Guesthouse (Duoyishu)", eat: "Guesthouse kitchen: Hani red rice, CNY 30-50/person" },
    { day: "Day 12", title: "Yuanyang: the sunrise that sells out", detail: "4:30 AM at Duoyishu for the golden mirror terraces. Morning: Qingkou mushroom-house village. Afternoon: Bada panorama; evening: Laohuzui sunset. Bring a tripod and every layer you own.", stay: "Jackie's (second night)", eat: "Wild vegetable hotpot, Hani smoked pork" },
    { day: "Day 13", title: "Jingkou market & slow farewells", detail: "Morning: Jingkou market — Hani and Yi traders in full embroidered dress. Afternoon: one last viewpoint, then bus back to Kunming (6-7h).", stay: "Kunming hotel near the airport", eat: "Steam-pot chicken — one last Yunnan classic" },
    { day: "Day 14", title: "Depart from Kunming", detail: "Changshui Airport is one of China's largest — arrive 3h before international flights. Buy your bamboo basket souvenirs the night before; they're too big to fit in a carry-on.", stay: "—", eat: "—" },
  ] },
];

const schema = {
  "@type": "Article",
  "headline": "Yunnan Itineraries: 3 to 14 Day Travel Plans",
  "description": "Suggested Yunnan travel routes from a 3-day Kunming quick trip to a 14-day grand loop covering all eight major destinations.",
  "author": { "@type": "Person", "name": "Yunnan Guide Team" },
  "datePublished": "2026-04-01",
  "dateModified": "2026-08-07",
};
---

<BaseLayout
  title="Yunnan Itineraries: 3, 5, 8, 10 & 14 Day Plans 2026"
  description="Suggested travel routes for every type of traveler. 3-day Kunming express, 8-day classic northwest, 14-day grand Yunnan loop covering all eight destinations."
  ogType="article"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>

  <Nav />

  <main class="min-h-screen">
    <section class="pt-32 pb-16 bg-gradient-to-b from-brand-50 to-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Yunnan Itineraries</h1>
        <p class="text-lg text-gray-600">Route plans for every type of traveler, from a quick 3-day visit to a 14-day Yunnan grand tour.</p>
      </div>
    </section>

    <section class="pb-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <img src="/images/erhai-cycling.webp" alt="Cycling the Erhai Lake shore near Dali with Cangshan mountains in the background" class="w-full h-64 md:h-80 object-cover rounded-2xl shadow-sm" loading="lazy" decoding="async" />
      </div>
    </section>

    <section class="pb-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        {itineraries.map((itin, i) => (
          <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
            <div class="bg-brand-600 text-white px-6 py-4 flex items-center justify-between">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider opacity-75">Itinerary {i + 1}</span>
                <h2 class="text-xl font-bold mt-0.5">{itin.title}</h2>
              </div>
              <div class="text-right">
                <div class="text-2xl font-bold">{itin.days}</div>
                <div class="text-xs opacity-75">{itin.difficulty}</div>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-500 text-sm mb-4">{itin.subtitle}</p>
              <div class="mb-4">
                <span class="text-xs font-semibold text-brand-600 bg-brand-50 px-3 py-1 rounded-full">Route: {itin.route}</span>
              </div>
              <ul class="space-y-2">
                {itin.highlights.map(h => (
                  <li class="flex items-start gap-2 text-sm text-gray-600">
                    <span class="text-brand-500 mt-0.5"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="6"/></svg></span>
                    {h}
                  </li>
                ))}
              </ul>
              {itin.dayByDay && itin.dayByDay.length > 0 && (
                <div class="mt-6 border-t border-gray-100 pt-6">
                  <h3 class="font-bold text-gray-900 text-sm mb-4">Day-by-Day Breakdown</h3>
                  <div class="space-y-4">
                    {itin.dayByDay.map(d => (
                      <div class="rounded-lg bg-gray-50 p-4">
                        <div class="flex items-center gap-2 mb-1.5">
                          <span class="text-xs font-bold text-white bg-brand-600 px-2 py-0.5 rounded-full">{d.day}</span>
                          <span class="text-sm font-semibold text-gray-900">{d.title}</span>
                        </div>
                        <p class="text-sm text-gray-600 leading-relaxed">{d.detail}</p>
                        <div class="mt-2.5 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                          {d.stay && d.stay !== "—" && (
                            <div class="flex items-start gap-1.5 text-gray-500">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M2 4h20v2H2z"/><path d="M4 6v14h16V6"/><path d="M9 10h6v4H9z"/><path d="M4 16h16"/></svg>
                              <span><strong class="text-gray-700">Stay:</strong> {d.stay}</span>
                            </div>
                          )}
                          {d.eat && d.eat !== "—" && (
                            <div class="flex items-start gap-1.5 text-gray-500">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#26753d" stroke-width="2" stroke-linecap="round" class="shrink-0 mt-0.5"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg>
                              <span><strong class="text-gray-700">Eat:</strong> {d.eat}</span>
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <p class="text-xs text-gray-400 mt-4">Best for: {itin.who}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
